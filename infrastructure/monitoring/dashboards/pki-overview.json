    {
      "id": 7,
      "title": "dinosaur-wildcard - Certificate Status",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(certmanager_certificate_ready_status{name=\"dinosaur-wildcard\",condition=\"True\",issuer_name=\"dinosaur-ca\"}) or vector(-1)",
          "legendFormat": "dinosaur-wildcard",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "noValue": "UNKNOWN",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NOT READY",
                  "color": "red"
                },
                "1": {
                  "text": "READY",
                  "color": "green"
                },
                "-1": {
                  "text": "UNKNOWN",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
