      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * max(dinosaur_csfd_requests_last_24h) / max(dinosaur_csfd_request_limit)",
          "legendFormat": "",
          "instant": true,
          "range": false
