{
  "uid": "dinosaur-services-overview",
  "title": "Dinosaur NAS - Services Overview",
  "tags": [
    "dinosaur",
    "services",
    "blackbox",
    "https"
  ],
  "timezone": "Europe/Bratislava",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "System Overview",
      "type": "link",
      "url": "/d/dinosaur-system-overview"
    },
    {
      "title": "Storage Health",
      "type": "link",
      "url": "/d/dinosaur-storage-health"
