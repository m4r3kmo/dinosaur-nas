{
  "uid": "dinosaur-system-overview",
  "title": "Dinosaur NAS - System Overview",
  "tags": [
    "dinosaur",
    "system",
    "hardware"
  ],
  "timezone": "Europe/Bratislava",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Storage Health",
      "type": "link",
      "url": "/d/dinosaur-storage-health"
    },
    {
      "title": "GPU Monitoring",
      "type": "link",
      "url": "/d/dinosaur-gpu-monitoring"
    }
